# コピーして .env を作る（.env はコミットしない）
DB_HOST=db
DB_PORT=3306
DB_NAME=hotel_map
DB_USER=app
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-16chars
# Google Maps JavaScript API のキー（空なら Leaflet + OpenStreetMap だけが有効）。
# キーには HTTP リファラ制限（http://localhost:8080/* と http://127.0.0.1:8080/*）と、API 制限（Maps JavaScript API のみ）を付ける
GOOGLE_MAPS_API_KEY=
